{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goyang-youth",
  "main": ".open-next/worker.js",

  // nodejs_compat 와 2024-09-23 이후 날짜는 Next.js 구동에 필수다.
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // goyang-youth.<계정서브도메인>.workers.dev 주소를 켠다.
  // 대시보드에 "No URLs enabled"로 뜨면 이 값이 꺼져 있다는 뜻이다.
  // routes / custom_domain 은 일부러 두지 않는다. 계정 내 다른 워커나
  // 기존 도메인의 트래픽을 가로채지 않게 하기 위해서다.
  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // ⚠️ 이게 없으면 배포할 때마다 대시보드에서 넣은 일반 변수가 지워진다.
  // 공식 문서: wrangler deploy 는 기본적으로(--keep-vars=false) 배포 전에
  // 모든 vars 를 삭제하고 설정 파일에 있는 것만 남긴다.
  // 실제로 GG_API_KEY 를 대시보드에서 두 번 넣었는데 두 번 다 다음 배포가
  // 지웠다. 시크릿(비밀)은 삭제되지 않지만, 일반 변수로 넣는 실수를
  // 대비해 켜 둔다.
  "keep_vars": true

  // 온통청년 인증키는 여기에 적지 않는다. 평문으로 커밋되기 때문이다.
  // 배포 후 아래 명령으로 암호화된 시크릿으로 넣는다:
  //   npx wrangler secret put YOUTH_API_KEY
}
