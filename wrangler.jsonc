{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goyang-youth",
  "main": ".open-next/worker.js",

  // nodejs_compat 와 2024-09-23 이후 날짜는 Next.js 구동에 필수다.
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],

  // goyang-youth.<계정서브도메인>.workers.dev 주소를 켠다.
  // 대시보드에 "No URLs enabled"로 뜨면 이 값이 꺼져 있다는 뜻이다.
  // routes / custom_domain 은 일부러 두지 않는다. 계정 내 다른 워커나
  // 기존 도메인의 트래픽을 가로채지 않게 하기 위해서다.
  "workers_dev": true,

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }

  // 온통청년 인증키는 여기에 적지 않는다. 평문으로 커밋되기 때문이다.
  // 배포 후 아래 명령으로 암호화된 시크릿으로 넣는다:
  //   npx wrangler secret put YOUTH_API_KEY
}
