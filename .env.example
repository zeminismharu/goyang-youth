# 이 파일을 .env.local 로 복사해서 값을 채우세요.
#   cp .env.example .env.local
#
# .env.local 은 .gitignore에 등록되어 있어 깃에 올라가지 않습니다.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 마세요. 붙이면 브라우저에 인증키가 노출됩니다.

# 온통청년(youthcenter.go.kr) OPEN API 인증키 — 서버에서만 사용
YOUTH_API_KEY=

# 경기데이터드림 Open API 인증키 — 보조 데이터 소스 (선택)
# https://data.gg.go.kr 로그인 후 인증키 신청
# 없어도 앱은 온통청년 데이터만으로 정상 동작합니다.
GG_API_KEY=
